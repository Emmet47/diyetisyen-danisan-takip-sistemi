digraph G {
 graph [rankdir=TB, nodesep=0.35, ranksep=0.45, fontname="DejaVu Sans"];
 node [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
 edge [style=invis];
 UserRole [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>UserRole</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">Admin<BR ALIGN="LEFT"/>Dietitian<BR ALIGN="LEFT"/>Client<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 Sex [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>Sex</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">Female<BR ALIGN="LEFT"/>Male<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 GoalType [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>GoalType</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">LoseWeight<BR ALIGN="LEFT"/>Maintain<BR ALIGN="LEFT"/>GainWeight<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 RestrictionType [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>RestrictionType</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">Allergy<BR ALIGN="LEFT"/>Dislike<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 PlanType [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>PlanType</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">Daily<BR ALIGN="LEFT"/>Weekly<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 { rank=same; UserRole; Sex; GoalType; RestrictionType; PlanType; }
 UserRole -> Sex -> GoalType -> RestrictionType -> PlanType;
 PlanStatus [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>PlanStatus</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">Draft<BR ALIGN="LEFT"/>Published<BR ALIGN="LEFT"/>Archived<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 MealLogStatus [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>MealLogStatus</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">Eaten<BR ALIGN="LEFT"/>Partial<BR ALIGN="LEFT"/>Skipped<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 AppointmentStatus [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>AppointmentStatus</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">Requested<BR ALIGN="LEFT"/>Confirmed<BR ALIGN="LEFT"/>Cancelled<BR ALIGN="LEFT"/>Completed<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 SubscriptionStatus [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>SubscriptionStatus</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">Active<BR ALIGN="LEFT"/>Expired<BR ALIGN="LEFT"/>Cancelled<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 NotificationType [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>NotificationType</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">AppointmentRequested<BR ALIGN="LEFT"/>AppointmentConfirmed<BR ALIGN="LEFT"/>AppointmentCancelled<BR ALIGN="LEFT"/>AppointmentRescheduled<BR ALIGN="LEFT"/>AppointmentReminder<BR ALIGN="LEFT"/>PlanPublished<BR ALIGN="LEFT"/>MealLogReminder<BR ALIGN="LEFT"/>MeasurementReminder<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 { rank=same; PlanStatus; MealLogStatus; AppointmentStatus; SubscriptionStatus; NotificationType; }
 PlanStatus -> MealLogStatus -> AppointmentStatus -> SubscriptionStatus -> NotificationType;
 NutrientTotals [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«value object»</FONT><BR/><B>NutrientTotals</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">+EnergyKcal: decimal<BR ALIGN="LEFT"/>+ProteinG: decimal<BR ALIGN="LEFT"/>+CarbsG: decimal<BR ALIGN="LEFT"/>+FatG: decimal<BR ALIGN="LEFT"/>+/ProteinPercent: decimal<BR ALIGN="LEFT"/>+/CarbsPercent: decimal<BR ALIGN="LEFT"/>+/FatPercent: decimal<BR ALIGN="LEFT"/><U>+Zero: NutrientTotals</U><BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">+Add(other: NutrientTotals): NutrientTotals<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 TimeSlot [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«value object»</FONT><BR/><B>TimeSlot</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">+Start: DateTime<BR ALIGN="LEFT"/>+End: DateTime<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">+Overlaps(other: TimeSlot): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 PhotoInfo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«value object»</FONT><BR/><B>PhotoInfo</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">+Key: string<BR ALIGN="LEFT"/>+ContentType: string<BR ALIGN="LEFT"/>+SizeBytes: int<BR ALIGN="LEFT"/><U>+MaxSizeBytes: int = 5242880</U><BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><U>+Create(key: string, contentType: string, sizeBytes: int): PhotoInfo</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
 NotificationSettings [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«value object»</FONT><BR/><B>NotificationSettings</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">+Appointments: bool<BR ALIGN="LEFT"/>+MealReminders: bool<BR ALIGN="LEFT"/>+Measurements: bool<BR ALIGN="LEFT"/>+Plans: bool<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
 ClientProfile [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#999999"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">«value object»</FONT><BR/><B>ClientProfile</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">+FullName: string<BR ALIGN="LEFT"/>+Phone: string [0..1]<BR ALIGN="LEFT"/>+GoalType: GoalType<BR ALIGN="LEFT"/>+TargetWeightKg: decimal [0..1]<BR ALIGN="LEFT"/>+Preferences: string [0..1]<BR ALIGN="LEFT"/>+AllergyNotes: string [0..1]<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
 { rank=same; NutrientTotals; TimeSlot; PhotoInfo; NotificationSettings; ClientProfile; }
 NutrientTotals -> TimeSlot -> PhotoInfo -> NotificationSettings -> ClientProfile;
 UserRole -> PlanStatus -> NutrientTotals;
}