<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Altyapı (sürülen / driven adapter'lar): EF Core + PostgreSQL, repository'ler, migration'lar,
    USDA adapter'ı, SeaweedFS (S3), FCM, SMTP, QuestPDF, sahte ödeme (FakePaymentAdapter).
    Application'daki port arayüzlerini uygular.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Ddts.Application\Ddts.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PasswordHasher (PBKDF2) ve IHttpContextAccessor ASP.NET Core'un içinde geliyor -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- JwtTokenService token üretmek için Microsoft.IdentityModel paketlerini buradan alır -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- SmtpEmailAdapter: e-posta gönderme -->
    <PackageReference Include="MailKit" />
  </ItemGroup>

</Project>
