# -------------------------------------------------------------
#  Ortam değişkenleri şablonu (docker compose bu dosyanın kopyası olan .env'i okur)
#  Kullanım:  cp .env.example .env   → sonra boş değerleri kendiniz doldurun.
#  .env git'e gönderilmez. Bu şablonda gerçek parola/anahtar YOK, olmamalı.
# -------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=ddts
POSTGRES_USER=ddts
# Yerel veritabanı parolası: istediğiniz bir şey yazın
POSTGRES_PASSWORD=

# SeaweedFS (S3 uyumlu fotoğraf deposu)
S3_ACCESS_KEY=ddts-dev
# Yerel depo gizli anahtarı: istediğiniz bir şey yazın
S3_SECRET_KEY=
S3_BUCKET=meal-photos

# JWT imzalama anahtarı: en az 32 karakter, rastgele
#   Linux/WSL:  openssl rand -base64 48
JWT_SIGNING_KEY=

# USDA FoodData Central API anahtarı (https://fdc.nal.usda.gov/api-key-signup) — boş kalırsa yalnızca yerel besin kayıtları kullanılır
# Anahtar yalnızca sunucuda (API) kullanılır; web/mobil koda asla yazılmaz.
USDA_API_KEY=
