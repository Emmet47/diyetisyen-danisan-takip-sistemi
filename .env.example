# -------------------------------------------------------------
#  Ortam değişkenleri şablonu (docker compose bu dosyanın kopyası olan .env'i okur)
#  Kullanım:  cp .env.example .env   → sonra boş değerleri kendiniz doldurun.
#  .env git'e gönderilmez. Bu şablonda gerçek parola/anahtar YOK, olmamalı.
# -------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=ddts
POSTGRES_USER=ddts
# Yerel veritabanı parolası: istediğiniz bir şey yazın
POSTGRES_PASSWORD=

# SeaweedFS (S3 uyumlu fotoğraf deposu)
S3_ACCESS_KEY=ddts-dev
# Yerel depo gizli anahtarı: istediğiniz bir şey yazın
S3_SECRET_KEY=
S3_BUCKET=meal-photos
# Fotoğrafın imzalı (10 dakikalık) bağlantısı bu adresle üretilir; tarayıcı ve telefon bu adrese ulaşabilmeli.
# Boş kalırsa http://localhost:8333 (yalnızca bilgisayardaki tarayıcı). Telefon/emülatör için bilgisayarın
# yerel IP'si: ör. http://192.168.1.20:8333
STORAGE_PUBLIC_URL=

# JWT imzalama anahtarı: en az 32 karakter, rastgele
#   Linux/WSL:  openssl rand -base64 48
JWT_SIGNING_KEY=

# USDA FoodData Central API anahtarı (https://fdc.nal.usda.gov/api-key-signup) — boş kalırsa yalnızca yerel besin kayıtları kullanılır
# Anahtar yalnızca sunucuda (API) kullanılır; web/mobil koda asla yazılmaz.
USDA_API_KEY=

# PlateRank (https://platerank.dev) salt-okunur veri anahtarı: Türk yemekleri buradan aranır. Anahtar sitenin
# SSS bölümünde ("Veriye API ile erişebilir miyim?") herkese açık yazıyor. Boş kalırsa PlateRank aranmaz.
# Veri CC BY 4.0: arayüzde "PlateRank (platerank.dev)" atfı gösterilir.
PLATERANK_API_KEY=

# DeepL API Free anahtarı (https://www.deepl.com/pro-api, ayda 500.000 karakter ücretsiz, kart istemez).
# USDA'ya giden Türkçe aramayı İngilizceye, gelen besin adlarını Türkçeye çevirir. Boş kalırsa çeviri yapılmaz.
# Anahtar yalnızca sunucuda (API) kullanılır; web/mobil koda asla yazılmaz.
DEEPL_API_KEY=

# Firebase Cloud Messaging (telefona push bildirimi) servis hesabı JSON dosyasının yolu — boş kalırsa push gönderilmez,
# bildirimler yine uygulama içi listede görünür. Dosya gizlidir: git'e eklenmez, istemcilere verilmez.
FCM_CREDENTIALS_PATH=

# İlk platform yöneticisi (yalnızca hiç yönetici yoksa oluşturulur). Parola en az 8 karakter.
ADMIN_EMAIL=admin@ornek.test
ADMIN_PASSWORD=
